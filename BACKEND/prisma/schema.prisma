// AMUSEMENT PARK MANAGEMENT SYSTEM
// PRISMA DATABASE SCHEMA
// Database: PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  ANALYST
}


enum TicketType {
  CHILD
  ADULT
  SENIOR
  FAMILY
  VIP
}


enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}


enum PaymentMethod {
  CASH
  CARD
  MOBILE_BANKING
  DEMO_GATEWAY
}


enum RideStatus {
  ACTIVE
  CLOSED
  UNDER_MAINTENANCE
}


enum StaffRole {
  RIDE_OPERATOR
  MAINTENANCE_TECHNICIAN
  SECURITY
  TICKET_OFFICER
  MANAGER
}


enum MaintenanceStatus {
  REQUESTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}


enum FeedbackStatus {
  PENDING
  REVIEWED
  RESOLVED
}


enum FeedbackType {
  FEEDBACK
  COMPLAINT
  SAFETY_REPORT
}


enum EntryStatus {
  ENTERED
  EXITED
  DENIED
}


enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}


enum EmergencyRequestStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}


model Admin {
  id String @id @default(uuid()) @db.Uuid() @map("admin_id")

  adminName String @db.VarChar(100) @map("admin_name")

  email String @unique @db.VarChar(255)

  passwordHash String @db.VarChar(255) @map("password_hash")

  role AdminRole @default(MANAGER)

  phone String? @db.VarChar(20)

  lastLogin DateTime? @map("last_login")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")


  emergencyAlerts EmergencyAlert[]
    @relation("AdminCreatedEmergencyAlerts")


  @@map("admins")
}

model Customer {
  id String @id @default(uuid()) @db.Uuid() @map("customer_id")

  name String @db.VarChar(100)

  phone String @unique @db.VarChar(20)

  email String @unique @db.VarChar(255)

  passwordHash String @db.VarChar(255) @map("password_hash")

  age Int

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")


  tickets Ticket[]

  rideUsages RideUsage[]

  feedbacks Feedback[]

  emergencyRequests EmergencyRequest[]


  @@index([isActive])

  @@map("customers")
}

model Zone {
  id String @id @default(uuid()) @db.Uuid() @map("zone_id")

  zoneName String @unique @db.VarChar(100) @map("zone_name")

  description String? @db.Text()

  mapX Int? @map("map_x")

  mapY Int? @map("map_y")


  rides Ride[]

  emergencyAlerts EmergencyAlert[]

  emergencyRequests EmergencyRequest[]


  @@map("zones")
}


model Staff {
  id String @id @default(uuid()) @db.Uuid() @map("staff_id")

  name String @db.VarChar(100)

  role StaffRole

  phone String @unique @db.VarChar(20)

  email String @unique @db.VarChar(255)

  passwordHash String @db.VarChar(255) @map("password_hash")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")


  maintenanceRecords Maintenance[]

  createdEmergencyAlerts EmergencyAlert[]
    @relation("StaffCreatedEmergencyAlerts")

  assignedEmergencyRequests EmergencyRequest[]


  @@index([role])

  @@index([isActive])

  @@map("staff")
}


model Ride {
  id String @id @default(uuid()) @db.Uuid() @map("ride_id")

  rideName String @unique @db.VarChar(120) @map("ride_name")

  description String? @db.Text()

  capacity Int

  minimumAge Int @default(5) @map("minimum_age")

  intensityLevel Int @default(1) @map("intensity_level")

  cycleDurationMinutes Int
    @default(5)
    @map("cycle_duration_minutes")

  status RideStatus @default(ACTIVE)

  currentQueueCount Int
    @default(0)
    @map("current_queue_count")

  currentWaitTimeMinutes Int
    @default(0)
    @map("current_wait_time_minutes")

  lastStatusUpdatedAt DateTime
    @default(now())
    @map("last_status_updated_at")


  zoneId String @db.Uuid() @map("zone_id")

  zone Zone
    @relation(
      fields: [zoneId],
      references: [id],
      onDelete: Restrict
    )


  rideUsages RideUsage[]

  queueSnapshots RideQueueSnapshot[]

  maintenanceRecords Maintenance[]

  feedbacks Feedback[]


  @@index([zoneId])

  @@index([status])

  @@index([currentWaitTimeMinutes])

  @@map("rides")
}


model Ticket {
  id String @id @default(uuid()) @db.Uuid() @map("ticket_id")

  visitDate DateTime @db.Date @map("visit_date")

  ticketType TicketType @map("ticket_type")

  ticketPrice Decimal
    @db.Decimal(10, 2)
    @map("ticket_price")

  paymentStatus PaymentStatus
    @default(PENDING)
    @map("payment_status")

  paymentDate DateTime? @map("payment_date")

  qrCode String
    @unique
    @db.VarChar(255)
    @map("qr_code")

  bookedAt DateTime
    @default(now())
    @map("booked_at")


  customerId String @db.Uuid() @map("customer_id")

  customer Customer
    @relation(
      fields: [customerId],
      references: [id],
      onDelete: Cascade
    )


  paymentTransactions PaymentTransaction[]

  parkEntries ParkEntry[]

  rideUsages RideUsage[]


  @@index([customerId])

  @@index([visitDate])

  @@index([ticketType])

  @@index([paymentStatus])

  @@map("tickets")
}



model PaymentTransaction {
  id String
    @id
    @default(uuid())
    @db.Uuid()
    @map("payment_id")

  amount Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod @map("payment_method")

  transactionReference String
    @unique
    @db.VarChar(100)
    @map("transaction_reference")

  status PaymentStatus @default(PENDING)

  paidAt DateTime? @map("paid_at")

  createdAt DateTime
    @default(now())
    @map("created_at")


  ticketId String @db.Uuid() @map("ticket_id")

  ticket Ticket
    @relation(
      fields: [ticketId],
      references: [id],
      onDelete: Cascade
    )


  @@index([ticketId])

  @@index([status])

  @@index([createdAt])

  @@map("payment_transactions")
}



model ParkEntry {
  id String
    @id
    @default(uuid())
    @db.Uuid()
    @map("entry_id")

  gateName String @db.VarChar(100) @map("gate_name")

  entryTime DateTime
    @default(now())
    @map("entry_time")

  exitTime DateTime? @map("exit_time")

  status EntryStatus @default(ENTERED)


  ticketId String @db.Uuid() @map("ticket_id")

  ticket Ticket
    @relation(
      fields: [ticketId],
      references: [id],
      onDelete: Cascade
    )


  @@index([ticketId])

  @@index([entryTime])

  @@index([status])

  @@map("park_entries")
}


model RideUsage {
  id String
    @id
    @default(uuid())
    @db.Uuid()
    @map("usage_id")

  entryTime DateTime
    @default(now())
    @map("entry_time")


  customerId String @db.Uuid() @map("customer_id")

  rideId String @db.Uuid() @map("ride_id")

  ticketId String? @db.Uuid() @map("ticket_id")


  customer Customer
    @relation(
      fields: [customerId],
      references: [id],
      onDelete: Cascade
    )

  ride Ride
    @relation(
      fields: [rideId],
      references: [id],
      onDelete: Cascade
    )

  ticket Ticket?
    @relation(
      fields: [ticketId],
      references: [id],
      onDelete: SetNull
    )


  @@index([customerId])

  @@index([rideId])

  @@index([ticketId])

  @@index([entryTime])

  @@map("ride_usage")
}



model RideQueueSnapshot {
  id String
    @id
    @default(uuid())
    @db.Uuid()
    @map("snapshot_id")

  waitingCount Int @map("waiting_count")

  estimatedWaitMinutes Int
    @map("estimated_wait_minutes")

  recordedAt DateTime
    @default(now())
    @map("recorded_at")


  rideId String @db.Uuid() @map("ride_id")

  ride Ride
    @relation(
      fields: [rideId],
      references: [id],
      onDelete: Cascade
    )


  @@index([rideId])

  @@index([recordedAt])

  @@index([rideId, recordedAt])

  @@map("ride_queue_snapshots")
}



model Maintenance {
  id String
    @id
    @default(uuid())
    @db.Uuid()
    @map("maintenance_id")

  issueDescription String
    @db.Text()
    @map("issue_description")

  maintenanceDate DateTime
    @db.Date
    @map("maintenance_date")

  status MaintenanceStatus
    @default(REQUESTED)

  completedAt DateTime? @map("completed_at")

  createdAt DateTime
    @default(now())
    @map("created_at")


  rideId String @db.Uuid() @map("ride_id")

  staffId String? @db.Uuid() @map("staff_id")


  ride Ride
    @relation(
      fields: [rideId],
      references: [id],
      onDelete: Cascade
    )

  staff Staff?
    @relation(
      fields: [staffId],
      references: [id],
      onDelete: SetNull
    )


  @@index([rideId])

  @@index([staffId])

  @@index([status])

  @@index([maintenanceDate])

  @@map("maintenance")
}


model Feedback {
  id String
    @id
    @default(uuid())
    @db.Uuid()
    @map("feedback_id")

  type FeedbackType @default(FEEDBACK)

  rating Int

  comments String? @db.Text()

  status FeedbackStatus @default(PENDING)

  submittedAt DateTime
    @default(now())
    @map("submitted_at")


  customerId String @db.Uuid() @map("customer_id")

  rideId String? @db.Uuid() @map("ride_id")


  customer Customer
    @relation(
      fields: [customerId],
      references: [id],
      onDelete: Cascade
    )

  ride Ride?
    @relation(
      fields: [rideId],
      references: [id],
      onDelete: SetNull
    )


  @@index([customerId])

  @@index([rideId])

  @@index([type])

  @@index([rating])

  @@index([status])

  @@map("feedback")
}

model EmergencyAlert {
  id String
    @id
    @default(uuid())
    @db.Uuid()
    @map("alert_id")

  title String @db.VarChar(150)

  message String @db.Text()

  severity AlertSeverity @default(INFO)

  isActive Boolean
    @default(true)
    @map("is_active")

  createdAt DateTime
    @default(now())
    @map("created_at")

  resolvedAt DateTime? @map("resolved_at")


  zoneId String? @db.Uuid() @map("zone_id")

  createdByAdminId String?
    @db.Uuid()
    @map("created_by_admin_id")

  createdByStaffId String?
    @db.Uuid()
    @map("created_by_staff_id")


  zone Zone?
    @relation(
      fields: [zoneId],
      references: [id],
      onDelete: SetNull
    )

  createdByAdmin Admin?
    @relation(
      "AdminCreatedEmergencyAlerts",
      fields: [createdByAdminId],
      references: [id],
      onDelete: SetNull
    )

  createdByStaff Staff?
    @relation(
      "StaffCreatedEmergencyAlerts",
      fields: [createdByStaffId],
      references: [id],
      onDelete: SetNull
    )


  @@index([zoneId])

  @@index([createdByAdminId])

  @@index([createdByStaffId])

  @@index([severity])

  @@index([isActive])

  @@index([createdAt])

  @@map("emergency_alerts")
}


model EmergencyRequest {
  id String
    @id
    @default(uuid())
    @db.Uuid()
    @map("request_id")

  message String @db.Text()

  locationNote String?
    @db.VarChar(255)
    @map("location_note")

  status EmergencyRequestStatus @default(OPEN)

  createdAt DateTime
    @default(now())
    @map("created_at")

  resolvedAt DateTime? @map("resolved_at")


  customerId String @db.Uuid() @map("customer_id")

  zoneId String? @db.Uuid() @map("zone_id")

  assignedStaffId String?
    @db.Uuid()
    @map("assigned_staff_id")


  customer Customer
    @relation(
      fields: [customerId],
      references: [id],
      onDelete: Cascade
    )

  zone Zone?
    @relation(
      fields: [zoneId],
      references: [id],
      onDelete: SetNull
    )

  assignedStaff Staff?
    @relation(
      fields: [assignedStaffId],
      references: [id],
      onDelete: SetNull
    )


  @@index([customerId])

  @@index([zoneId])

  @@index([assignedStaffId])

  @@index([status])

  @@index([createdAt])

  @@map("emergency_requests")
}